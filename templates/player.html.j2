<!doctype html>
<html>
<head>
    <meta charset="utf-8"
        name="referrer"
        content="strict-origin-when-cross-origin"
    >
    <title>Analog YouTube</title>

    <style>
        html,
        body {
            margin: 0;
            background: black;
            width: 100%;
            height: 100%;
            overflow: hidden;
            cursor: none;
        }

        #player {
            width: 100vw;
            height: 100vh;
        }

        #waiting {
            color: white;
            font-family: sans-serif;
            font-size: 3rem;

            position: absolute;
            inset: 0;

            display: flex;
            justify-content: center;
            align-items: center;
        }

        #player-overlay {
            position: fixed;
            inset: 0;
            pointer-events: none;
            z-index: 1000;
        }

        #action-icon {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);

            font-family: sans-serif;
            font-size: 5rem;
            color: white;

            background: rgba(0, 0, 0, 0.6);
            border-radius: 50%;

            width: 7rem;
            height: 7rem;

            display: none;
            align-items: center;
            justify-content: center;
        }

        #progress-container {
            position: absolute;
            left: 3%;
            right: 3%;
            bottom: 3%;

            height: 10px;

            background: rgba(255, 255, 255, 0.35);
            border-radius: 5px;

            display: none;
            overflow: hidden;
        }

        #progress-bar {
            height: 100%;
            width: 0;

            background: white;
            border-radius: inherit;
        }

        #request-received-notification {
            position: absolute;
            top: 5%;
            left: 50%;
            transform: translate(-50%, -12px);
            width: min(86vw, 42rem);
            box-sizing: border-box;
            padding: 1rem 1.5rem;
            border: 1px solid rgba(255, 255, 255, 0.28);
            border-radius: 12px;
            background: rgba(18, 24, 27, 0.94);
            color: white;
            font-family: sans-serif;
            text-align: center;
            box-shadow: 0 10px 32px rgba(0, 0, 0, 0.5);
            opacity: 0;
            visibility: hidden;
            transition: opacity 180ms ease, transform 180ms ease, visibility 180ms;
        }

        #request-received-notification.is-visible {
            transform: translate(-50%, 0);
            opacity: 1;
            visibility: visible;
        }

        #request-received-notification-label {
            display: block;
            margin-bottom: 0.3rem;
            color: #9ee7cf;
            font-size: 0.8rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }

        #request-received-notification-title {
            display: block;
            overflow: hidden;
            font-size: clamp(1rem, 2.4vh, 1.5rem);
            font-weight: 600;
            line-height: 1.3;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

        @media (prefers-reduced-motion: reduce) {
            #request-received-notification {
                transition: none;
            }
        }
    </style>

    <script src="https://www.youtube.com/iframe_api"></script>
</head>

<body>
    <div id="youtube-player"></div>
    <video
        id="local-player"
        style="display: none; width: 100vw; height: 100vh;"
        autoplay
    ></video>
    <div id="player-overlay">
        <div id="action-icon"></div>

        <div id="progress-container">
            <div id="progress-bar"></div>
        </div>

        <div id="request-received-notification" role="status" aria-live="polite" aria-hidden="true">
            <span id="request-received-notification-label">Request received</span>
            <span id="request-received-notification-title"></span>
        </div>
    </div>
</body>

<script>
    const localPlayer = document.getElementById("local-player");
    let youtubeContainer = null;
    let youtubePlayer = null;

    let source = "youtube";

    let expectedVideoId = null;
    let currentSessionId = null;
    let sequence = 0;
    let socker = null;
    let scrubInterval = null;
    let scrubStartedAt = null;

    const actionIcon = document.getElementById("action-icon");
    const progressContainer = document.getElementById("progress-container");
    const progressBar = document.getElementById("progress-bar");
    const requestReceivedNotification = document.getElementById("request-received-notification");
    const requestReceivedNotificationTitle = document.getElementById("request-received-notification-title");

    let overlayTimeout = null;
    let requestReceivedNotificationTimeout = null;

    function showOverlay(icon, timeout=1500) {
        if (source === "youtube") {
            return;
        }
        actionIcon.textContent = icon;

        actionIcon.style.display = "flex";
        progressContainer.style.display = "block";

        clearTimeout(overlayTimeout);

        overlayTimeout = setTimeout(() => {
            actionIcon.style.display = "none";
            progressContainer.style.display = "none";
        }, timeout);
    }

    function updateProgressBar() {
        const duration = getDuration();
        const currentTime = getCurrentTime();

        if (!duration || !Number.isFinite(duration)) {
            return;
        }

        progressBar.style.width =
            `${(currentTime / duration) * 100}%`;
    }

    setInterval(updateProgressBar, 250);

    function getCurrentPlayer() {
        return source === "youtube" ? youtubePlayer : localPlayer;
    }

    function getCurrentTime() {
        if(source === "youtube") {
            return youtubePlayer.getCurrentTime();
        } else {
            return localPlayer.currentTime;
        }
    }

    function getDuration() {
        if(source === "youtube") {
            return youtubePlayer.getDuration();
        } else {
            return localPlayer.duration;
        }
    }

    function seekTo(player, time) {
        if(source === "youtube") {
            player.seekTo(time, true);
        } else {
            player.currentTime = time;
        }
    }


    function startScrubbing(direction) {
        stopScrubbing();

        scrubStartedAt = Date.now();

        // Give a tap an immediate small seek.
        seekTo(getCurrentPlayer(), getCurrentTime() + (direction * 2));

        scrubInterval = setInterval(() => {
            const heldForSeconds = (Date.now() - scrubStartedAt) / 1000;

            let seekAmount;

            if (heldForSeconds < 2) {
                seekAmount = 1;
            } else if (heldForSeconds < 5) {
                seekAmount = 3;
            } else {
                seekAmount = 8;
            }

            seekTo(getCurrentPlayer(), getCurrentTime() + (direction * seekAmount));
        }, 250);
    }

    function stopScrubbing() {
        if (scrubInterval !== null) {
            clearInterval(scrubInterval);
            scrubInterval = null;
        }

        scrubStartedAt = null;
    }

    function getActualVideoId() {
        if (source === "youtube") {
            return youtubePlayer.getVideoData()?.video_id ?? null;
        } else {
            const src = localPlayer.getAttribute("src")
            return src.split('/').pop();
        }
    }

    function sendPlayerState(state) {
        if (!socket || socket.readyState !== WebSocket.OPEN) {
            return;
        }

        if (!currentSessionId) {
            return;
        }

        const actualVideoId = getActualVideoId();

        const message = {
            type: "player_state",

            session_id: currentSessionId,
            sequence: ++sequence,

            expected_video_id: expectedVideoId,
            actual_video_id: actualVideoId,

            state: state,

            current_time: getCurrentTime(),
            duration: getDuration()
        };
        console.log(`Sending message: ${JSON.stringify(message)}...`);
        socket.send(JSON.stringify(message));
    }

    function onPlayerStateChanged(event) {
        const state = event.data;
        sendPlayerState(state);
    }

    window.onYouTubeIframeAPIReady = function () {
        youtubePlayer = new YT.Player("youtube-player", {
            width: "100%",
            height: "100%",

            playerVars: {
                autoplay: 1,
                controls: 1,
                disablekb: 1,
                fs: 0,
                playsinline: 1,
                rel: 0,
                origin: window.location.origin
            },

            events: {
                onAutoplayBlocked: function () {
                    console.error("YouTube autoplay was blocked.");
                },
                onStateChange: onPlayerStateChanged,
                onError: function (event) {
                    console.error(
                        `YouTube player error: ${event.data}`
                    );
                }
            }
        });

        youtubeContainer = document.getElementById("youtube-player");
    };

    function togglePlayer(new_source) {
        source = new_source;
        if(new_source === 'youtube') {
            localPlayer.pause();
            localPlayer.removeAttribute("src");
            localPlayer.load();

            localPlayer.style.display = "none";
            youtubeContainer.style.display = "block";
        } else {
            youtubePlayer.pauseVideo();
            youtubeContainer.style.display = "none";
            localPlayer.style.display = "block";
        }
    }

    function playYoutubeVideo(videoId, sessionId) {
        if (!youtubePlayer || typeof youtubePlayer.loadVideoById !== "function") {
            expectedVideoId = videoId;
            return;
        }

        togglePlayer('youtube');

        currentSessionId = sessionId;
        sequence = 0;

        youtubePlayer.loadVideoById({
            videoId: videoId
        });

        youtubePlayer.playVideo();
    }

    function playLocalVideo(videoId, sessionId) {
        togglePlayer('local');

        currentSessionId = sessionId;
        sequence = 0;

        localPlayer.pause();

        localPlayer.removeAttribute("src");
        localPlayer.load();

        localPlayer.currentTime = 0;

        localPlayer.src = `/api/localVideos/${videoId}`;
        localPlayer.load();

        localPlayer.play();
    }

    function playVideo() {
        if(source === "youtube") {
            youtubePlayer.playVideo();
        } else {
            localPlayer.play();
        }
    }

    function pauseVideo() {
        if(source === "youtube") {
            youtubePlayer.pauseVideo();
        } else {
            localPlayer.pause();
        }
    }

    function handlePlayPause() {
        if(source === "youtube") {
            const state = youtubePlayer.getPlayerState();
            if (state === YT.PlayerState.PLAYING) {
                youtubePlayer.pauseVideo();
            } else {
                youtubePlayer.playVideo();
            }
        } else {
            const isPaused = localPlayer.paused;
            if (!isPaused) {
                localPlayer.pause();
                showOverlay("Ⅱ");
            } else {
                localPlayer.play();
                showOverlay("▶");
            }
        }
    }

    function handleControl(command) {
        const actualVideoId = getActualVideoId();
        if (actualVideoId === null) {
            return;
        }

        console.log(`Received command: ${command}`);
        switch (command) {
            case "play":
                playVideo();
                showOverlay("▶");
                break;

            case "pause":
                pauseVideo();
                showOverlay("Ⅱ");
                break;

            case "play_pause":
                handlePlayPause();
                break;

            case "seek_forward":
                seekTo(getCurrentPlayer(), getCurrentTime() + 10);
                showOverlay("»");
                break;

            case "seek_backward":
                seekTo(getCurrentPlayer(), Math.max(getCurrentTime() - 10, 0));
                showOverlay("«");
                break;
            case "scrub_forward_start":
                startScrubbing(5);
                showOverlay("»");
                break;

            case "scrub_backward_start":
                startScrubbing(-5);
                showOverlay("«");
                break;

            case "scrub_stop":
                stopScrubbing();
                break;
        }
    }

    function toggleRequestReceivedNotification(value, title) {
        clearTimeout(requestReceivedNotificationTimeout);
        requestReceivedNotificationTimeout = null;

        if (!value) {
            requestReceivedNotification.classList.remove("is-visible");
            requestReceivedNotification.setAttribute("aria-hidden", "true");
            return;
        }

        requestReceivedNotificationTitle.textContent = title || "Your video";
        requestReceivedNotification.setAttribute("aria-hidden", "false");
        requestReceivedNotification.classList.add("is-visible");

        requestReceivedNotificationTimeout = setTimeout(() => {
            toggleRequestReceivedNotification(false, "");
        }, 10000);
    }

    function connectWebSocket() {
        const protocol =
            location.protocol === "https:" ? "wss:" : "ws:";

        socket = new WebSocket(
            `${protocol}//${location.host}/ws/player`
        );

        socket.onmessage = (event) => {
            const message = JSON.parse(event.data);

            switch (message.type) {
                case "play":
                    toggleRequestReceivedNotification(false, '');
                    if(message.source === "youtube") {
                        playYoutubeVideo(message.video_id, message.session_id);
                    } else if(message.source === "local" || message.source === "library") {
                        playLocalVideo(message.video_id, message.session_id);
                    }
                    
                    break;

                case "control":
                    handleControl(message.command);
                    break;

                case "request_received":
                    toggleRequestReceivedNotification(true, message.video_title);
                    break;

            }
        };

        socket.onopen = function () {
            console.log("Player WebSocket connected.");
        };

        socket.onclose = function () {
            console.warn("Player WebSocket disconnected; reconnecting...");
            setTimeout(connectWebSocket, 2000);
        };

        socket.onerror = function () {
            socket.close();
        };
    }

    function sendPlaybackProgress() {
        if (!currentSessionId) {
            return;
        }

        if (!socket || socket.readyState !== WebSocket.OPEN) {
            return;
        }

        if (source === "youtube") {
            if (!youtubePlayer) {
                return;
            }

            if (youtubePlayer.getPlayerState() !== YT.PlayerState.PLAYING) {
                return;
            }
        } else {
            if(!localPlayer) {
                return;
            }
            if (localPlayer.paused) {
                return;
            }
        }

        const message = {
            type: "playback_progress",

            session_id: currentSessionId,
            sequence: ++sequence,

            actual_video_id: getActualVideoId(),

            current_time: getCurrentTime(),
            duration: getDuration()
        };
        console.log(`Sending message ${JSON.stringify(message)}...`);
        socket.send(JSON.stringify(message));
    }


    setInterval(sendPlaybackProgress, 10000);

    connectWebSocket();
</script>

</body>
</html>