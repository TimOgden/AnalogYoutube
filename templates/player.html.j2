<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta
        name="viewport"
        content="width=device-width, initial-scale=1"
    >

    <title>Analog YouTube</title>

    <style>
        html,
        body,
        #player {
            width: 100%;
            height: 100%;
            margin: 0;
            overflow: hidden;
            background: black;
        }

        iframe {
            width: 100%;
            height: 100%;
            border: 0;
        }
    </style>
</head>

<body>
    <div id="player"></div>

    <script src="https://www.youtube.com/iframe_api"></script>

    <script>
        let player;

        function onYouTubeIframeAPIReady() {
            player = new YT.Player("player", {
                videoId: {{ youtube_video_id | tojson }},
                width: "100%",
                height: "100%",
                playerVars: {
                    autoplay: 1,
                    controls: 0,
                    disablekb: 0,
                    fs: 0,
                    playsinline: 1,
                    rel: 0
                },
                events: {
                    onReady: event => {
                        event.target.playVideo();
                    },
                    onStateChange: event => {
                        if (event.data === YT.PlayerState.ENDED) {
                            window.location.href = "/";
                        }
                    }
                }
            });
        }
    </script>
</body>
</html>