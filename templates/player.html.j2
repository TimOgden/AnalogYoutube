<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>Analog YouTube</title>

    <style>
        html,
        body {
            margin: 0;
            background: black;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        #player {
            width: 100vw;
            height: 100vh;
        }

        #waiting {
            color: white;
            font-family: sans-serif;
            font-size: 3rem;

            position: absolute;
            inset: 0;

            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>

    <script src="https://www.youtube.com/iframe_api"></script>
</head>

<body>


<div id="player"></div>

<script>
    let player = null;
    let expectedVideoId = null;
    let currentSessionId = null;
    let sequence = 0;
    let socker = null;
    let scrubInterval = null;
    let scrubStartedAt = null;

    function startScrubbing(direction) {
        stopScrubbing();

        scrubStartedAt = Date.now();

        // Give a tap an immediate small seek.
        player.seekTo(
            player.getCurrentTime() + (direction * 2),
            true
        );

        scrubInterval = setInterval(() => {
            const heldForSeconds = (Date.now() - scrubStartedAt) / 1000;

            let seekAmount;

            if (heldForSeconds < 2) {
                seekAmount = 1;
            } else if (heldForSeconds < 5) {
                seekAmount = 3;
            } else {
                seekAmount = 8;
            }

            player.seekTo(
                player.getCurrentTime() + (direction * seekAmount),
                true
            );
        }, 250);
    }

    function stopScrubbing() {
        if (scrubInterval !== null) {
            clearInterval(scrubInterval);
            scrubInterval = null;
        }

        scrubStartedAt = null;
    }

    function sendPlayerState(state) {
        if (!socket || socket.readyState !== WebSocket.OPEN) {
            return;
        }

        if (!currentSessionId) {
            return;
        }

        const actualVideoId =
            player.getVideoData()?.video_id ?? null;

        const message = {
            type: "player_state",

            session_id: currentSessionId,
            sequence: ++sequence,

            expected_video_id: expectedVideoId,
            actual_video_id: actualVideoId,

            state: state,

            current_time: player.getCurrentTime(),
            duration: player.getDuration()
        };
        console.log(`Sending message: ${JSON.stringify(message)}...`);
        socket.send(JSON.stringify(message));
    }

    function onPlayerStateChanged(event) {
        const state = event.data;
        sendPlayerState(state);
    }

    window.onYouTubeIframeAPIReady = function () {
        player = new YT.Player("player", {
            width: "100%",
            height: "100%",

            playerVars: {
                autoplay: 1,
                controls: 1,
                disablekb: 1,
                fs: 0,
                playsinline: 1,
                rel: 0
            },

            events: {
                onReady: function () {
                    if (expectedVideoId) {
                        playVideo(expectedVideoId);
                    }
                },

                onAutoplayBlocked: function () {
                    console.error("YouTube autoplay was blocked.");
                },
                onStateChange: onPlayerStateChanged
            }
        });
    };

    function playVideo(videoId, sessionId) {
        if (!player || typeof player.loadVideoById !== "function") {
            expectedVideoId = videoId;
            return;
        }

        currentSessionId = sessionId;
        sequence = 0;

        player.loadVideoById({
            videoId: videoId
        });

        player.playVideo();
    }

    function handleControl(command) {
        const actualVideoId =
            player.getVideoData()?.video_id ?? null;
        if (actualVideoId === null) {
            return;
        }

        console.log(`Received command: ${command}`);
        switch (command) {
            case "play":
                player.playVideo();
                break;

            case "pause":
                player.pauseVideo();
                break;

            case "play_pause":
                const state = player.getPlayerState();

                if (state === YT.PlayerState.PLAYING) {
                    player.pauseVideo();
                } else {
                    player.playVideo();
                }

                break;

            case "seek_forward":
                player.seekTo(
                    player.getCurrentTime() + 10,
                    true
                );
                break;

            case "seek_backward":
                player.seekTo(
                    Math.max(player.getCurrentTime() - 10, 0),
                    true
                );
                break;
            case "scrub_forward_start":
                startScrubbing(5);
                break;

            case "scrub_backward_start":
                startScrubbing(-5);
                break;

            case "scrub_stop":
                stopScrubbing();
                break;
        }
    }

    function connectWebSocket() {
        const protocol =
            location.protocol === "https:" ? "wss:" : "ws:";

        socket = new WebSocket(
            `${protocol}//${location.host}/ws/player`
        );

        socket.onmessage = (event) => {
            const message = JSON.parse(event.data);

            switch (message.type) {
                case "play":
                    playVideo(message.video_id, message.session_id);
                    break;

                case "control":
                    handleControl(message.command);
                    break;
            }
        };

        socket.onopen = function () {
            console.log("Player WebSocket connected.");
        };

        socket.onclose = function () {
            console.warn("Player WebSocket disconnected; reconnecting...");
            setTimeout(connectWebSocket, 2000);
        };

        socket.onerror = function () {
            socket.close();
        };
    }

    function sendPlaybackProgress() {
        if (!player) {
            return;
        }

        if (!currentSessionId) {
            return;
        }

        if (player.getPlayerState() !== YT.PlayerState.PLAYING) {
            return;
        }

        if (!socket || socket.readyState !== WebSocket.OPEN) {
            return;
        }

        const message = {
            type: "playback_progress",

            session_id: currentSessionId,
            sequence: ++sequence,

            actual_video_id:
                player.getVideoData()?.video_id ?? null,

            current_time: player.getCurrentTime(),
            duration: player.getDuration()
        };
        console.log(`Sending message ${JSON.stringify(message)}...`);
        socket.send(JSON.stringify(message));
    }


    setInterval(sendPlaybackProgress, 10000);

    connectWebSocket();
</script>

</body>
</html>