<!doctype html>
<html>
<head>
    <meta charset="utf-8">
    <title>Analog YouTube</title>

    <style>
        html,
        body {
            margin: 0;
            background: black;
            width: 100%;
            height: 100%;
            overflow: hidden;
        }

        #player {
            width: 100vw;
            height: 100vh;
        }

        #waiting {
            color: white;
            font-family: sans-serif;
            font-size: 3rem;

            position: absolute;
            inset: 0;

            display: flex;
            justify-content: center;
            align-items: center;
        }
    </style>

    <script src="https://www.youtube.com/iframe_api"></script>
</head>

<body>

<div id="waiting">
    Scan a QR code
</div>

<div id="player"></div>

<script>
    let player = null;
    let expectedVideoId = null;
    let currentSessionId = null;
    let sequence = 0;

    function sendPlayerState(state) {
        if (!socket || socket.readyState !== WebSocket.OPEN) {
            return;
        }

        if (!currentSessionId) {
            return;
        }

        const actualVideoId =
            player.getVideoData()?.video_id ?? null;

        socket.send(JSON.stringify({
            type: "player_state",

            session_id: currentSessionId,
            sequence: ++sequence,

            expected_video_id: expectedVideoId,
            actual_video_id: actualVideoId,

            state: state,

            current_time: player.getCurrentTime(),
            duration: player.getDuration()
        }));
    }

    function onPlayerStateChanged(event) {
        const state = event.data;
        sendPlayerState(state);
    }

    window.onYouTubeIframeAPIReady = function () {
        player = new YT.Player("player", {
            width: "100%",
            height: "100%",

            playerVars: {
                autoplay: 1,
                controls: 1,
                disablekb: 1,
                fs: 0,
                playsinline: 1,
                rel: 0
            },

            events: {
                onReady: function () {
                    if (expectedVideoId) {
                        playVideo(expectedVideoId);
                    }
                },

                onAutoplayBlocked: function () {
                    console.error("YouTube autoplay was blocked.");
                },
                onStateChanged: onPlayerStateChanged
            }
        });
    };

    function playVideo(videoId, sessionId) {
        if (!player || typeof player.loadVideoById !== "function") {
            expectedVideoId = videoId;
            return;
        }

        currentSessionId = sessionId;
        sequence = 0;

        document.getElementById("waiting").style.display = "none";

        player.loadVideoById({
            videoId: videoId
        });

        player.playVideo();
    }

    function connectWebSocket() {
        const protocol =
            location.protocol === "https:" ? "wss:" : "ws:";

        const socket = new WebSocket(
            `${protocol}//${location.host}/ws/player`
        );

        socket.onmessage = function (event) {
            console.log(event.data);
            const message = JSON.parse(event.data);

            if (message.type === "play") {
                playVideo(message.video_id, message.session_id);
            }
        };

        socket.onopen = function () {
            console.log("Player WebSocket connected.");
        };

        socket.onclose = function () {
            console.warn("Player WebSocket disconnected; reconnecting...");
            setTimeout(connectWebSocket, 2000);
        };

        socket.onerror = function () {
            socket.close();
        };
    }

    function sendPlaybackProgress() {
        if (!player) {
            return;
        }

        if (!currentSessionId) {
            return;
        }

        if (player.getPlayerState() !== YT.PlayerState.PLAYING) {
            return;
        }

        if (!socket || socket.readyState !== WebSocket.OPEN) {
            return;
        }

        socket.send(JSON.stringify({
            type: "playback_progress",

            session_id: currentSessionId,
            sequence: ++sequence,

            actual_video_id:
                player.getVideoData()?.video_id ?? null,

            current_time: player.getCurrentTime(),
            duration: player.getDuration()
        }));
    }


    setInterval(sendPlaybackProgress, 10000);

    connectWebSocket();
</script>

</body>
</html>